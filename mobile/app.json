{
  "expo": {
    "name": "Datacenter IoT",
    "slug": "datacenter-iot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datacenteriot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5074ccc4-8e60-4c31-9777-a4fa30689cb5",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.betaiot.datacenter",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#060b28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060b28"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5074ccc4-8e60-4c31-9777-a4fa30689cb5"
      }
    },
    "owner": "joaogabrielfelix"
  }
}
