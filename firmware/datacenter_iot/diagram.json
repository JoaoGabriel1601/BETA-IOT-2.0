{
  "version": 1,
  "author": "Datacenter IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-dht22", "id": "dht", "top": -100, "left": -180, "attrs": {} },

    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 0, "left": -200, "attrs": {} },

    { "type": "wokwi-pushbutton", "id": "btn_pir", "top": 100, "left": -180,
      "attrs": { "color": "red", "label": "PIR (simulated)" } },

    { "type": "wokwi-potentiometer", "id": "pot_voltage", "top": 200, "left": -200,
      "attrs": { "label": "ZMPT (sim)" } },

    { "type": "wokwi-buzzer", "id": "buzz", "top": -100, "left": 200, "attrs": { "volume": "0.1" } },

    { "type": "wokwi-led", "id": "led_solar", "top": 0, "left": 220,
      "attrs": { "color": "yellow", "label": "Solar" } },
    { "type": "wokwi-led", "id": "led_diesel", "top": 60, "left": 220,
      "attrs": { "color": "orange", "label": "Diesel" } },

    { "type": "wokwi-resistor", "id": "r_ldr", "top": 40, "left": -120,
      "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_led1", "top": 0, "left": 160,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_led2", "top": 60, "left": 160,
      "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:D4", "green", [] ],

    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:AO", "esp:D34", "green", [] ],
    [ "ldr:GND", "esp:GND.2", "black", [] ],

    [ "btn_pir:1.l", "esp:3V3", "red", [] ],
    [ "btn_pir:2.l", "esp:D27", "green", [] ],

    [ "pot_voltage:VCC", "esp:3V3", "red", [] ],
    [ "pot_voltage:GND", "esp:GND.3", "black", [] ],
    [ "pot_voltage:SIG", "esp:D35", "green", [] ],

    [ "buzz:1", "esp:D25", "green", [] ],
    [ "buzz:2", "esp:GND.1", "black", [] ],

    [ "esp:D26", "r_led1:1", "green", [] ],
    [ "r_led1:2", "led_solar:A", "green", [] ],
    [ "led_solar:C", "esp:GND.2", "black", [] ],

    [ "esp:D33", "r_led2:1", "green", [] ],
    [ "r_led2:2", "led_diesel:A", "green", [] ],
    [ "led_diesel:C", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
}
